          "response": [
            {
              "name": "Ingestion Status Response",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"operational\",\n  \"database_connected\": true,\n  \"statistics\": {\n    \"total_floats\": 1250,\n    \"total_profiles\": 45000,\n    \"total_measurements\": 1500000,\n    \"processed_files\": 125,\n    \"failed_files\": 2\n  }\n}"
