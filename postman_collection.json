              "name": "SQL Preview Response",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"sql\": \"SELECT m.temperature, m.salinity, m.pressure, p.latitude, p.longitude, p.profile_time FROM measurements m JOIN profiles p ON m.profile_id = p.id WHERE p.profile_time >= '2024-01-01' AND p.profile_time < '2024-02-01' LIMIT 1000\",\n  \"method\": \"rule_based\",\n  \"intent\": {\n    \"primary_intent\": \"list\",\n    \"query_type\": \"data\"\n  }\n}"
