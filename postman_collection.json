        {
          "name": "Ingest File from URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"https://data.argo.ucsd.edu/pub/argo/dac/aoml/1900001/1900001_prof.nc\",\n  \"is_url\": true,\n  \"is_directory\": false,\n  \"force\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/ingestion/ingest/",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "ingestion", "ingest", ""]
            },
            "description": "Trigger ingestion of a NetCDF file from a URL.\n\nParameters:\n- source: URL of the NetCDF file\n- is_url: true for URL sources\n- is_directory: false for single files\n- force: true to reprocess already processed files"
          },
          "response": [
            {
              "name": "Ingestion Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"success\",\n  \"result\": {\n    \"type\": \"file\",\n    \"source\": \"https://example.com/argo_data.nc\",\n    \"result\": {\n      \"file_path\": \"https://example.com/argo_data.nc\",\n      \"status\": \"success\",\n      \"records_inserted\": 15000,\n      \"profiles_created\": 500,\n      \"floats_created\": 25,\n      \"error\": null\n    },\n    \"stats\": {\n      \"total_floats\": 1275,\n      \"total_profiles\": 45500,\n      \"total_measurements\": 1515000,\n      \"processed_files\": 126,\n      \"failed_files\": 2\n    }\n  }\n}"
            }
          ]
        },
