    {
      "name": "Chat API",
      "description": "Natural language query endpoints for ocean data analysis",
      "item": [
        {
          "name": "Natural Language Query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"What is the average temperature in the Indian Ocean?\",\n  \"context\": {},\n  \"include_data\": true,\n  \"max_rows\": 100\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/{{api_version}}/chat/",
              "host": ["{{base_url}}"],
              "path": ["api", "{{api_version}}", "chat", ""]
            },
            "description": "Process a natural language query and return structured analytics with visualizations.\n\nParameters:\n- query: Natural language question about ocean data\n- context: Optional context from previous queries\n- include_data: Whether to include raw data in response\n- max_rows: Maximum rows to return (1-10000)"
          },
          "response": [
            {
              "name": "Successful Query",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"success\",\n  \"query_id\": \"a1b2c3d4\",\n  \"text_response\": \"The average temperature is 24.5°C based on 150,000 measurements.\",\n  \"numeric_summary\": {\n    \"total_records\": 150000,\n    \"columns_returned\": [\"temperature\"],\n    \"numeric_stats\": {\n      \"temperature\": {\n        \"mean\": 24.5,\n        \"std\": 3.2,\n        \"min\": 2.1,\n        \"max\": 32.4,\n        \"median\": 24.8\n      }\n    }\n  },\n  \"analytics\": {\n    \"insights\": [\n      \"The average temperature is 24.5°C\",\n      \"Analysis based on 150,000 records\"\n    ],\n    \"trends\": null,\n    \"anomalies\": null,\n    \"recommendations\": null\n  },\n  \"visualization\": {\n    \"chart_type\": \"histogram\",\n    \"title\": \"Temperature Distribution\",\n    \"x_axis\": {\"label\": \"Temperature (°C)\", \"field\": \"bin_label\"},\n    \"y_axis\": {\"label\": \"Frequency\", \"field\": \"count\"},\n    \"data\": []\n  },\n  \"data\": [],\n  \"query_info\": {\n    \"intent\": \"statistics\",\n    \"query_type\": \"statistics\",\n    \"sql_query\": \"SELECT AVG(m.temperature)...\",\n    \"execution_time_ms\": 45.2\n  },\n  \"execution_time_ms\": 123.45\n}"
            }
          ]
        },
