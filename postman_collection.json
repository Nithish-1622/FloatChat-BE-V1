            "description": "Check the overall health status of the system including database connectivity and AI service availability."
          },
          "response": [
            {
              "name": "Healthy Response",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"status\": \"healthy\",\n  \"timestamp\": \"2024-01-15T10:30:00.000Z\",\n  \"components\": {\n    \"database\": {\n      \"status\": \"connected\",\n      \"floats\": 1250,\n      \"profiles\": 45000,\n      \"measurements\": 1500000\n    },\n    \"ai\": {\n      \"status\": \"available\",\n      \"provider\": \"groq\"\n    }\n  }\n}"
